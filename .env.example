# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Application ID (only needed for npm run deploy)
CLIENT_ID=
# Optional: register commands instantly in a test server
GUILD_ID=
# Optional: reuse your existing MongoDB points/languages; omit for local JSON storage
MONGO=
# Optional: persistent directory for JSON storage (one bot process only)
DATA_DIR=./data
# Supported: ar / en
DEFAULT_LANGUAGE=ar
PREFIX=-
GAME_TIMEOUT_SECONDS=20
# Set false if you register separately with npm run deploy
REGISTER_COMMANDS=true
# Optional health endpoint, for hosts that require an HTTP port
# PORT=3000
